# Visit-notification emails (api/notify.ts). Set these in Vercel → Project → Settings → Environment Variables.
# Get a key at https://resend.com (free tier is fine).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where the visit emails go (defaults to this address if omitted)
NOTIFY_TO=francis@creativedevlabs.com

# Sender. The default onboarding@resend.dev can only deliver to your own Resend account email.
# To email francis@creativedevlabs.com, verify a domain in Resend and use e.g. "Wildcard Site <notify@yourdomain.com>".
NOTIFY_FROM=Wildcard Site <onboarding@resend.dev>
